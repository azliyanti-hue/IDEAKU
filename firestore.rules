rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives & Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    // Validation Blueprint for PitchDeck
    function isValidPitchDeck(data) {
      return data.keys().hasAll(['id', 'ownerId', 'clientName', 'campaignName', 'channel', 'slot', 'slides']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.ownerId is string && data.ownerId == request.auth.uid &&
        data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 200 &&
        data.campaignName is string && data.campaignName.size() > 0 && data.campaignName.size() <= 300 &&
        data.channel is string && data.channel.size() > 0 && data.channel.size() <= 50 &&
        data.slot is string && data.slot.size() > 0 && data.slot.size() <= 200 &&
        data.slides is list && data.slides.size() >= 1 && data.slides.size() <= 15 &&
        (!('briefNotes' in data) || (data.briefNotes is string && data.briefNotes.size() <= 5000)) &&
        (!('budgetTier' in data) || (data.budgetTier is string && data.budgetTier.size() <= 50)) &&
        (!('targetKpi' in data) || (data.targetKpi is string && data.targetKpi.size() <= 100)) &&
        (!('recommendedTier' in data) || (data.recommendedTier is string && data.recommendedTier.size() <= 50)) &&
        (!('grossImpressions' in data) || (data.grossImpressions is string && data.grossImpressions.size() <= 50)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation Blueprint for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('role' in data) || (data.role is string && (data.role == 'strategist' || data.role == 'planner' || data.role == 'admin'))) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Collection: pitch_decks
    match /pitch_decks/{deckId} {
      allow get: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(deckId) &&
        incoming().ownerId == request.auth.uid &&
        isValidPitchDeck(incoming());
      allow update: if isSignedIn() &&
        isValidId(deckId) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == request.auth.uid &&
        isValidPitchDeck(incoming());
      allow delete: if isSignedIn() &&
        isValidId(deckId) &&
        existing().ownerId == request.auth.uid;
    }

    // Collection: users
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        isValidId(userId) &&
        isValidUserProfile(incoming());
      allow update: if isSignedIn() &&
        request.auth.uid == userId &&
        isValidId(userId) &&
        existing().uid == request.auth.uid &&
        isValidUserProfile(incoming());
      allow delete: if false;
    }
  }
}
